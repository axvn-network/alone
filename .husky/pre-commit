#!/bin/bash
# Pre-commit hook to enforce project standards
echo "--- Running pre-commit checks ---"

# Run linting (via lint-staged)
npx lint-staged
if [ $? -ne 0 ]; then
  echo "Linting failed!"
  exit 1
fi

# Run type check
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "Type check failed!"
  exit 1
fi

# Check for circular dependencies
npx madge --circular src/
if [ $? -ne 0 ]; then
  echo "Circular dependencies found!"
  exit 1
fi

echo "--- All checks passed ---"
