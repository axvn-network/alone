# ================================================================
# FORTRESS INVESTMENT HOLDINGS — ENVIRONMENT CONFIG
# Copy this file to .env.local and fill in all required values.
# NEVER commit .env.local to version control.
#
# Generate secrets:
#   SESSION_SECRET: openssl rand -hex 32
# ================================================================

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://fortressih.com

# ── Database (MongoDB) ───────────────────────────────────────────
# Local MongoDB (after running scripts/setup.sh):
#   MONGODB_URI=mongodb://127.0.0.1:27017/fortress_db
# Atlas / Cloud MongoDB:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fortress_db?retryWrites=true&w=majority

# ── Admin credentials ────────────────────────────────────────────
# Used for first-run admin user seed and env-based fallback auth.
# After first deploy, change the password via Admin Settings UI.
ADMIN_NAME=SuperAdmin
ADMIN_EMAIL=admin@fortressih.com
ADMIN_PASSWORD=123456
# ── Security: Session ────────────────────────────────────────────
# HMAC-SHA256 key for signing admin session cookies.
# Minimum 32 characters.  Generate: openssl rand -hex 32
# Rotating this value immediately invalidates all active sessions.
SESSION_SECRET=replace_with_output_of__openssl_rand_-hex_32

# ── Email (Nodemailer / SMTP) ────────────────────────────────────
# Gmail: enable "App Passwords" at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Fortress Investment <no-reply@fortressih.com>

# ── Cloudinary (image & document uploads) ───────────────────────
# Sign up free at cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── AI Assistant (Google Gemini) ─────────────────────────────────
# Miễn phí tại: https://aistudio.google.com/apikey (1500 req/ngày)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Backup ───────────────────────────────────────────────────────
# Days to keep MongoDB backups (scripts/backup.sh)
BACKUP_RETENTION_DAYS=30

# ── WhatsApp Business Cloud API (webhook auto-reply) ─────────────────────────
# 1. Tạo Meta App tại developers.facebook.com
# 2. Thêm WhatsApp product, tạo Business Account
# 3. Lấy Phone Number ID và Access Token
# 4. Đặt webhook URL: https://<domain>/api/whatsapp/webhook
# 5. Đăng ký events: messages
WHATSAPP_VERIFY_TOKEN=fortress_webhook_2025
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v20.0
