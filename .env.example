# ================================================================
# FORTRESS INVESTMENT HOLDINGS — ENVIRONMENT CONFIG
# Copy this file to .env.local and fill in all required values.
# NEVER commit .env.local to version control.
#
# Generate secrets:
#   SESSION_SECRET: openssl rand -hex 32
# ================================================================

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://fortressih.com

# ── Database (MongoDB) ───────────────────────────────────────────
# Local MongoDB (after running scripts/setup.sh):
#   MONGODB_URI=mongodb://127.0.0.1:27017/fortress_db
# Atlas / Cloud MongoDB:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fortress_db?retryWrites=true&w=majority

# ── Admin credentials ────────────────────────────────────────────
# Used for first-run admin user seed and env-based fallback auth.
# After first deploy, change the password via Admin Settings UI.
ADMIN_NAME=SuperAdmin
ADMIN_EMAIL=admin@fortressih.com
ADMIN_PASSWORD=your_strong_password_here_min_12_chars

# ── Security: Session ────────────────────────────────────────────
# HMAC-SHA256 key for signing admin session cookies.
# Minimum 32 characters.  Generate: openssl rand -hex 32
# Rotating this value immediately invalidates all active sessions.
SESSION_SECRET=replace_with_output_of__openssl_rand_-hex_32

# ── Email (Nodemailer / SMTP) ────────────────────────────────────
# Gmail: enable "App Passwords" at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Fortress Investment <no-reply@fortressih.com>

# ── Cloudinary (image & document uploads) ───────────────────────
# Sign up free at cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Backup ───────────────────────────────────────────────────────
# Days to keep MongoDB backups (scripts/backup.sh)
BACKUP_RETENTION_DAYS=30
