# ===================================================
# FORTRESS INVESTMENT HOLDINGS - VERCEL ENV TEMPLATE
# ===================================================

# App Environment Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://fortress98.netlify.app

# Database (MongoDB Atlas recommended for Vercel)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fortress_db?retryWrites=true&w=majority

# Security & Authentication (JWT Secret Key)
JWT_SECRET=fortress_super_secret_jwt_key_2026

# Initial Superadmin Account
ADMIN_NAME=SuperAdmin
ADMIN_EMAIL=admin@fortressih.com
ADMIN_PASSWORD=123456

# Email Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Fortress Investment <no-reply@fortressih.com>

# Cloud Storage (Cloudinary for image/document uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payment Integration Secrets
PAYMENT_MOMO_KEY=momo_api_secret_key
PAYMENT_BANK_KEY=vietqr_bank_api_key
PAYMENT_USDT_WALLET=0x1234567890abcdef1234567890abcdef12345678
PAYMENT_TELCO_KEY=telco_api_secret_key
