# ================================================================
# AXVN Tech Holding — ENVIRONMENT CONFIG
# Sao chép file này thành .env.local và điền đầy đủ các giá trị.
# KHÔNG commit .env.local lên version control.
#
# Tạo SESSION_SECRET:  openssl rand -hex 64
# ================================================================

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Database (MongoDB) ───────────────────────────────────────────
# Local MongoDB (sau khi chạy scripts/setup.sh):
#   MONGODB_URI=mongodb://127.0.0.1:27017/AXVN_db
# Atlas / Cloud MongoDB:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/AXVN_db?retryWrites=true&w=majority

# ── Admin credentials ────────────────────────────────────────────
# Dùng cho việc seed admin user lần đầu và fallback auth.
# Sau lần deploy đầu, đổi mật khẩu qua Admin Settings UI.
ADMIN_NAME=SuperAdmin
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_strong_password_min_12

# ── Security: Session & Keys ─────────────────────────────────────
# Admin session HMAC key. Min 64 chars. Tạo: openssl rand -hex 64
# Thay đổi sẽ vô hiệu hóa toàn bộ session đang hoạt động.
SESSION_SECRET=CHANGE_ME_run_openssl_rand_-hex_64

# (Khuyến nghị) Key CSRF riêng — nếu để trống, dùng SESSION_SECRET+":csrf"
# Tạo: openssl rand -hex 32
CSRF_SECRET=

# (Khuyến nghị) Key mã hóa AES-256-GCM cho dữ liệu cá nhân (NĐ 13/2023)
# Tạo: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Email (Nodemailer / SMTP) ────────────────────────────────────
# Gmail: bật "App Passwords" tại myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
# Display name in outgoing system emails (e.g. "AXVN Tech Holding")
SMTP_FROM_NAME=AXVN Tech Holding
# From-address in outgoing system emails
SMTP_FROM_EMAIL=no-reply@your-domain.com

# ── Cloudinary (image & document uploads) ───────────────────────
# Đăng ký miễn phí tại cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── AI Assistant (Anthropic Claude) ─────────────────────────────
# Lấy API key tại: https://console.anthropic.com/settings/keys
# Để trống để tắt AI assistant. Admin AI route trả về 503 nếu không có key.
ANTHROPIC_API_KEY=

# ── WhatsApp Business Cloud API ──────────────────────────────────
# 1. Tạo Meta App tại developers.facebook.com
# 2. Thêm WhatsApp product, tạo Business Account
# 3. Lấy Phone Number ID và Access Token
# 4. Đặt webhook URL: https://<domain>/api/whatsapp/webhook
# 5. Đăng ký events: messages
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v20.0
# App Secret dùng để verify X-Hub-Signature-256 (lấy tại Meta Developer App Settings)
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
NEXT_PUBLIC_WHATSAPP_NUMBER=+84901234567

# ── Analytics (optional — script KHÔNG inject khi bỏ trống hoặc để placeholder) ──
# Điền ID thật để bật tracking. Bỏ trống hoặc xóa dòng để tắt hoàn toàn.
# Google Analytics 4 — lấy tại: analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_ID=
# Meta Pixel — lấy tại: business.facebook.com → Events Manager
NEXT_PUBLIC_META_PIXEL_ID=

# ── Backup ───────────────────────────────────────────────────────
# Số ngày giữ lại backup MongoDB (scripts/backup.sh)
BACKUP_RETENTION_DAYS=30

# S3 offsite backup (tùy chọn — bỏ trống để chỉ backup local)
# Ví dụ: s3://my-bucket/AXVN-backups
S3_BUCKET=
# AWS profile (mặc định: default)
AWS_PROFILE=default

# ── Logging ──────────────────────────────────────────────────────
# Cấp độ log: debug | info | warn | error (mặc định: info trong production)
LOG_LEVEL=info
