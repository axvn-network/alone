{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/db": [
        "./src/core/database/index.ts"
      ],
      "@/validators": [
        "./src/shared/validators/index.ts"
      ],
      "@/validators/*": [
        "./src/shared/validators/*"
      ],
      "@/hooks": [
        "./src/shared/hooks/index.ts"
      ],
      "@/hooks/*": [
        "./src/shared/hooks/*"
      ],
      "@/utils/*": [
        "./src/shared/utils/*"
      ],
      "@/types": [
        "./src/shared/types/index.ts"
      ],
      "@/types/*": [
        "./src/shared/types/*"
      ],
      "@/constants": [
        "./src/shared/constants/index.ts"
      ],
      "@/constants/*": [
        "./src/shared/constants/*"
      ],
      "@/contexts": [
        "./src/shared/contexts/index.ts"
      ],
      "@/contexts/*": [
        "./src/shared/contexts/*"
      ],
      "@/blocks": [
        "./src/shared/components/blocks/index.ts"
      ],
      "@/blocks/*": [
        "./src/shared/components/blocks/*"
      ],
      "@/i18n": [
        "./src/i18n/index.ts"
      ],
      "@/i18n/*": [
        "./src/i18n/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "src/cli"
  ]
}
