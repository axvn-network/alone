# ================================================================
# .env.local — langding.tc-gaming.live
# Copy file này thành .env.local rồi điền đầy đủ các giá trị.
# KHÔNG commit file .env.local lên Git.
#
# Tạo SESSION_SECRET:  openssl rand -hex 32
# ================================================================

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://langding.tc-gaming.live

# ── Database (MongoDB) ───────────────────────────────────────────
# Local (sau khi chạy setup.sh):
MONGODB_URI=mongodb://127.0.0.1:27017/fortress_db
# Atlas / Cloud MongoDB (thay thế dòng trên nếu dùng Atlas):
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/fortress_db?retryWrites=true&w=majority

# ── Admin credentials ────────────────────────────────────────────
ADMIN_NAME=SuperAdmin
ADMIN_EMAIL=admin@tc-gaming.live
ADMIN_PASSWORD=CHANGE_ME_strong_password_min_12

# ── Security ─────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_run_openssl_rand_-hex_32

# ── Email (Nodemailer / SMTP) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=TC Gaming <no-reply@tc-gaming.live>

# ── Cloudinary (image & document uploads) ────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_cloudinary_api_key:your_cloudinary_api_secret@your_cloudinary_cloud_name

# ── Gemini AI ────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── WhatsApp (Meta Business API) ────────────────────────────────
# https://developers.facebook.com/docs/whatsapp
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
NEXT_PUBLIC_WHATSAPP_NUMBER=+84901234567

# ── Backup ───────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
